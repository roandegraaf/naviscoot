    "settings.scooter.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Naviscoot connects to a Segway scooter over Bluetooth with the password the Segway app paired with, and keeps it in this iPhone's keychain. Close the Segway app first, because the scooter accepts one connection at a time."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naviscoot maakt via Bluetooth verbinding met een Segway-scooter, met het wachtwoord waarmee de Segway-app gekoppeld is, en bewaart het in de sleutelhanger van deze iPhone. Sluit eerst de Segway-app, want de scooter accepteert één verbinding tegelijk."
          }
        }
      }
    },
