    "settings.voiceSection.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts only skips turn instructions but still speaks the unverified-path and speeding warnings. The voices are the ones installed for the app language; add more in iOS Settings › Accessibility › Spoken Content."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen waarschuwingen slaat de afslaginstructies over, maar spreekt de waarschuwingen voor onbevestigde paden en te hard rijden nog wel uit. De stemmen zijn die voor de app-taal zijn geïnstalleerd; meer stemmen voeg je toe in Instellingen › Toegankelijkheid › Gesproken materiaal."
          }
        }
      }
    },
